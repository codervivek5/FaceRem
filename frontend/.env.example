# Where the FastAPI backend is reachable from the Next.js server (not from the browser).
API_BASE_URL=http://127.0.0.1:8000

# Set to 1 only behind HTTPS; controls the Secure flag on the session cookies.
COOKIE_SECURE=0

# ---------------------------------------------------------------------------
# Android app download
# ---------------------------------------------------------------------------
# Where the APK lives. Leave unset and the download button shows an honest
# "not available yet" instead of linking to a 404.
#
#   a release page or CDN:  https://releases.example.com/faceattend-1.0.apk
#   or drop the file in public/downloads/ and use:  /downloads/faceattend.apk
#
# The landing page is statically prerendered, so this must be set when `next build` runs,
# not only at runtime. Changing it means rebuilding.
ANDROID_APK_URL=

# Shown next to the button. Optional.
ANDROID_APK_VERSION=1.0
ANDROID_APK_SIZE=61 MB
