<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. A development backend runs over plain HTTP on whatever address the
  machine happens to have today, so pinning hosts here would mean editing this file every
  time the network changes.

  This file replaces the one in src/main for debug builds. Release builds keep that one,
  which permits no cleartext at all.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
