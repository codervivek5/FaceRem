# Copy to .env and edit. Never commit a real .env.
APP_ENV=dev

# PostgreSQL (what this project runs on). The password is URL-encoded, so if yours
# contains @ : / or # you must percent-encode it.
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@localhost:5432/facerem

# SQLite needs no server and is fine for a quick local run or the test suite:
#   DATABASE_URL=sqlite:///./faceattend.db

# CHANGE THIS. Outside dev the app refuses to start on the default, or on anything
# shorter than 32 bytes. Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# stub = weak image descriptor, for wiring and tests only.
# insightface = real ArcFace embeddings (pip install insightface onnxruntime).
FACE_ENGINE=stub
FACE_MATCH_THRESHOLD=0.62

# Liveness is performed on-device by the Android SDK; the server enforces the threshold.
# client_attested = trust the client score, but audit it. disabled = skip entirely.
LIVENESS_MODE=client_attested
LIVENESS_THRESHOLD=0.7

# Minutes after check-in before a further scan is treated as check-out. Repeat scans inside
# this window answer ALREADY_PRESENT, which is what an unattended gate kiosk shows all day.
CHECKOUT_AFTER_MINUTES=240

# Shift start used to derive late minutes in this PoC.
SHIFT_START_HOUR=9
SHIFT_GRACE_MINUTES=10

SEED_DEMO_DATA=true
